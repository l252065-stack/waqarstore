// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Boys' Trousers catalog ─────────────────────────────────────────────────

model Product {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  brand       String?
  category    String            @default("boys-trousers")
  imageUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variants    ProductVariant[]
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int

  // Sizing dimensions
  ageRange   String   // e.g. "2-3Y", "4-5Y", "6-7Y", "8-9Y", "10-11Y", "12-13Y"
  waistSize  String   // e.g. "40cm", "45cm", "50cm", "55cm", "60cm"
  length     String   // e.g. "Short", "Regular", "Long"

  // Physical properties
  material   String   // e.g. "Cotton", "Denim", "Polyester", "Linen", "Wool Blend"
  color      String?
  fit        String?  // e.g. "Slim", "Regular", "Relaxed"

  // Inventory / pricing
  price      Float
  stock      Int      @default(0)
  sku        String   @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([ageRange])
  @@index([waistSize])
  @@index([length])
  @@index([material])
}

